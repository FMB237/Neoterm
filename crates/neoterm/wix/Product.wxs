<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="NeoTerm" 
           Language="1033" 
           Version="0.4.0" 
           Manufacturer="FMB237" 
           UpgradeCode="12345678-1234-1234-1234-123456789abc">
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="NeoTerm - GPU Terminal Emulator" 
             Comments="GPU-accelerated terminal emulator with tabs, splits, and themes" 
             Manufacturer="FMB237" />
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of NeoTerm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="NeoTerm" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
    <!-- Icon for the installer and shortcuts -->
    <Icon Id="icon.ico" SourceFile="neoterm.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="NeoTerm" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="NeoTerm" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Main executable -->
      <Component Id="neoterm.exe" Guid="*" Directory="INSTALLFOLDER">
        <File Id="neoterm.exe" Source="target/release/neoterm.exe" KeyPath="yes" />
      </Component>
      
      <!-- License -->
      <Component Id="LICENSE.rtf" Guid="*" Directory="INSTALLFOLDER">
        <File Id="LICENSE.rtf" Source="LICENSE.rtf" KeyPath="yes" />
      </Component>
      
      <!-- Icon -->
      <Component Id="neoterm.ico" Guid="*" Directory="INSTALLFOLDER">
        <File Id="neoterm.ico" Source="neoterm.ico" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="Shortcuts" Guid="*" Directory="ProgramMenuDir">
        <Shortcut Id="StartMenuShortcut" 
                  Name="NeoTerm" 
                  Description="GPU Terminal Emulator" 
                  Target="[INSTALLFOLDER]neoterm.exe" 
                  WorkingDirectory="INSTALLFOLDER" 
                  Icon="icon.ico" 
                  IconIndex="0" />
        <Shortcut Id="UninstallShortcut" 
                  Name="Uninstall NeoTerm" 
                  Target="[SystemFolder]msiexec.exe" 
                  Arguments="/x [ProductCode]" 
                  Description="Uninstall NeoTerm" />
        <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FMB237\NeoTerm" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <Component Id="RegistryEntries" Guid="*" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="Software\FMB237\NeoTerm">
        <RegistryValue Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
        <RegistryValue Name="Version" Value="0.4.0" Type="string" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\NeoTerm">
        <RegistryValue Name="DisplayName" Value="NeoTerm" Type="string" />
        <RegistryValue Name="DisplayVersion" Value="0.4.0" Type="string" />
        <RegistryValue Name="Publisher" Value="FMB237" Type="string" />
        <RegistryValue Name="InstallLocation" Value="[INSTALLFOLDER]" Type="string" />
        <RegistryValue Name="UninstallString" Value="msiexec.exe /x [ProductCode]" Type="string" />
        <RegistryValue Name="NoModify" Value="1" Type="integer" />
        <RegistryValue Name="NoRepair" Value="1" Type="integer" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\FMB237\NeoTerm">
        <RegistryValue Name="Installed" Value="1" Type="integer" KeyPath="yes" />
      </RegistryKey>
    </Component>
  </Fragment>

  <Fragment>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Launch NeoTerm" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NeoTerm after installation" />
    <CustomAction Id="LaunchApplication" 
                  BinaryKey="WixCA" 
                  DllEntry="WixShellExec" 
                  Impersonate="yes" 
                  Return="asyncNoWait" 
                  Execute="immediate" 
                  ExeCommand="[INSTALLFOLDER]neoterm.exe" />
    <UI>
      <Publish Dialog="ExitDialog" 
               Control="Finish" 
               Event="DoAction" 
               Value="LaunchApplication" 
               Order="999">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>
  </Fragment>
</Wix>
